# ============================================
# ANEXO24 Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# SQL Server connection (Modulo C - CALE_IMMEX)
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=CALE_IMMEX;encrypt=true;trustServerCertificate=true
DB_USERNAME=anexo24_app
DB_PASSWORD=CHANGE_ME

# SQL Server connection (esquema complementario - ANEXO24_DEV)
APP_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ANEXO24_DEV;encrypt=true;trustServerCertificate=true
APP_DB_USERNAME=anexo24_app
APP_DB_PASSWORD=CHANGE_ME

# Seguridad JWT
JWT_SECRET=CHANGE_ME_SECRETO_MINIMO_32_CARACTERES
JWT_EXPIRATION_MINUTES=480